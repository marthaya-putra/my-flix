# Database
DATABASE_URL=postgresql://username:password@localhost:5433/myflix

# TMDB API
TMDB_TOKEN=your_tmdb_token_here
INCLUDE_ADULT=false

# Google AI
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# Mastra platform (optional — traces export only when the token is set).
# Same names/values the platform dashboard hands you; the exporter reads
# the project id and endpoint vars from env itself.
# MASTRA_PLATFORM_ACCESS_TOKEN=your_mastra_platform_access_token_here
# MASTRA_PROJECT_ID=your_mastra_project_id_here
# MASTRA_PLATFORM_OBSERVABILITY_ENDPOINT=your_endpoint_here

# Auth
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
